{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jakcmencz/sentinel-ir-mcp",
  "title": "Sentinel-IR",
  "description": "Structural IR of JS/TS/Python/Rust files for AI agents: risk and signals instead of raw source.",
  "repository": {
    "url": "https://github.com/jakcmencz/sentinel-ir-mcp",
    "source": "github"
  },
  "websiteUrl": "https://gitlab.com/jakubrojicek11/sentinel-ir-mcp",
  "version": "0.5.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sentinel-ir-mcp",
      "version": "0.5.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "folder",
          "description": "Project folder the agent may read (read-only). Repeat for more folders; omit to use the MCP roots offered by the client.",
          "isRequired": false,
          "isRepeated": true
        }
      ]
    }
  ]
}
